# =============================================================
# Nova Safra CRM — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores reais
# NUNCA commite o arquivo .env.local
# =============================================================

# --- Supabase ---
# Obter em: supabase.com > Project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Resend (e-mail transacional) ---
# Obter em: resend.com > API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Domínio verificado no Resend (ex: novasafra.com.br)
RESEND_FROM_EMAIL=cotacoes@novasafra.com.br

# --- Stripe ---
# Obter em: stripe.com > Developers > API Keys (use chaves de TEST inicialmente)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# --- Google Maps (usado no formulário de cotação — issue-05) ---
# Obter em: console.cloud.google.com > APIs & Services > Credentials
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxx

# --- App ---
# URL pública da aplicação (localhost em desenvolvimento)
NEXT_PUBLIC_APP_URL=http://localhost:3000
